# Local development only. Never commit your real .env file.
# Production requires a unique random secret (at least 40 characters).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
MCAS_ENV=development
MCAS_SECRET_KEY=replace-with-a-unique-random-secret-at-least-40-characters
MCAS_DATABASE_PATH=./data/mcas.db
# Version shown in the customer Updates centre; bump for each centrally deployed release.
MCAS_VERSION=1.4.0
# Comma-separated administrator email addresses. Leave empty to disable in-app admin tools.
MCAS_ADMIN_EMAILS=

# Local examples. In production, use the exact HTTPS origin and real application hostname.
MCAS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MCAS_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Optional strict AI endpoint hostname allowlist; no wildcards.
# Groq: api.groq.com | Gemini: generativelanguage.googleapis.com
MCAS_AI_ALLOWED_HOSTS=api.groq.com

# Public business discovery and web search. Keep keys server-side.
SERPER_API_KEY=
SERPER_GL=ke
SERPER_HL=en

# AI provider. Keep key private in server-side .env / secret manager.
AI_API_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b

# Optional Gmail OAuth. MCAS creates drafts only; it does not read incoming emails or send messages.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/integrations/gmail/callback
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCAS_ENCRYPTION_KEY=

# Optional production billing. Catalogue/account prices are USD.
# Flutterwave USD card checkout is separate from Kenyan M-Pesa checkout (KES only).
# Set a trusted USD/KES quote and its ISO date; M-Pesa checkout is disabled if older than 3 days.
MCAS_USD_KES_RATE=
MCAS_USD_KES_RATE_DATE=
# Configure only after your merchant account/KYC and settlement bank account are approved.
# Never commit real values. Use deployment secrets in hosted environments.
FLW_SECRET_KEY=
FLW_SECRET_HASH=
# Exact public HTTPS origin, e.g. https://app.example.com (no trailing slash required)
MCAS_PUBLIC_URL=
