# Local development only. Never commit your real .env file.
# Production requires a unique random secret (at least 40 characters).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
MCAS_ENV=development
MCAS_SECRET_KEY=replace-with-a-unique-random-secret-at-least-40-characters
MCAS_DATABASE_PATH=./data/mcas.db
# Version shown in the customer Updates centre; bump for each centrally deployed release.
MCAS_VERSION=1.3.0
# Comma-separated administrator email addresses. Leave empty to disable in-app admin tools.
MCAS_ADMIN_EMAILS=
# Development convenience only: set false to use password-only admin login locally.
# Production startup rejects false. Keep true for hosted deployments.
MCAS_ADMIN_MFA_REQUIRED=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required only to provision a configured administrator and enroll first-time administrator MFA.
MCAS_ADMIN_BOOTSTRAP_TOKEN=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this separate MFA encryption key stable and secret; never commit it.
MCAS_ADMIN_MFA_ENCRYPTION_KEY=

# Local examples. In production, use the exact HTTPS origin and real application hostname.
MCAS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MCAS_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Optional strict AI endpoint hostname allowlist; no wildcards.
# Groq: api.groq.com | Gemini: generativelanguage.googleapis.com
MCAS_AI_ALLOWED_HOSTS=api.groq.com

# Public business discovery and web search. Keep keys server-side.
SERPER_API_KEY=
SERPER_GL=ke
SERPER_HL=en

# AI provider. Keep key private in server-side .env / secret manager.
AI_API_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
# Maximum feedback-improvement analysis attempts per UTC month (1-1000; default 10).
MCAS_AI_IMPROVEMENT_MONTHLY_LIMIT=10

# Optional Gmail OAuth. MCAS creates drafts only; it does not read incoming emails or send messages.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/integrations/gmail/callback
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCAS_ENCRYPTION_KEY=

# Account email verification. Configure a transactional SMTP provider before public signup.
MCAS_PUBLIC_BASE_URL=http://localhost:8000
MCAS_EMAIL_SMTP_HOST=
MCAS_EMAIL_SMTP_PORT=587
MCAS_EMAIL_SMTP_USERNAME=
MCAS_EMAIL_SMTP_PASSWORD=
MCAS_EMAIL_SMTP_USE_SSL=false
MCAS_EMAIL_SMTP_STARTTLS=true
MCAS_EMAIL_FROM=
MCAS_EMAIL_FROM_NAME=MCAS
# Google Sign-In (OAuth 2.0 Web application credentials)
# Configure the exact callback URL in Google Cloud Console:
# https://YOUR_PUBLIC_DOMAIN/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
