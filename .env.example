# Generate a unique value: python -c "import secrets; print(secrets.token_urlsafe(48))"
MCAS_ENV=development
MCAS_SECRET_KEY=replace-with-a-unique-random-secret-at-least-40-characters
MCAS_DATABASE_PATH=./data/mcas.db
MCAS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MCAS_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
MCAS_COOKIE_SECURE=false

# Optional public web research. Keep keys server-side.
# Preferred no-card option: Serper provides a signup free tier (check current quota/terms).
SERPER_API_KEY=
# Alternative provider; Brave requires payment-card verification.
BRAVE_SEARCH_API_KEY=

# Optional OpenAI-compatible AI endpoint. May incur provider charges.
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Optional Gmail OAuth (Google Cloud Console OAuth Web application).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/integrations/gmail/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCAS_ENCRYPTION_KEY=
